# plagiarism_engine 환경변수 (cp .env.example .env 후 채움)

# backend 내부 API (DB 단일 소유 — 여기로 위임)
JCQ_BACKEND_URL=http://127.0.0.1:8000
JCQ_INTERNAL_SECRET=change-me-internal      # backend와 동일 값
JCQ_ADMIN_TOKEN=change-me-admin             # admin dashboard 인바운드 인증

# 검출 파라미터
JCQ_PLAGIARISM_ENABLED=1
JCQ_PLAGIARISM_SIMILARITY_THRESHOLD=0.7     # Dolos similarity 0..1
JCQ_PLAGIARISM_TOP_K=50                      # 검토 큐에 올릴 상위 쌍 수
JCQ_PLAGIARISM_MIN_FRAGMENT=10               # 최소 최장 매칭 토큰
JCQ_PLAGIARISM_INCLUDE_VERDICT=AC            # AC 제출만 비교
# 유사도 엔진: auto(Dolos 시도→실패 시 winnow 폴백) | dolos(강제) | winnow(의존성 0, 순수 Python)
# 참고: Dolos는 native tree-sitter 빌드가 필요해 최신 node에서 실패할 수 있음 → 자동 winnow 폴백.
JCQ_PLAGIARISM_ENGINE=auto
JCQ_PLAGIARISM_LANGUAGE=python
JCQ_PLAGIARISM_MAX_CODE_BYTES=65536
JCQ_PLAGIARISM_ENSEMBLE_ENABLED=0            # Phase 2(멀티에이전트 판정) 스위치

# Dolos Node 헬퍼 (npm install in dolos_runner/ 필요)
JCQ_DOLOS_NODE=node
# JCQ_DOLOS_SCRIPT=<repo>/plagiarism_engine/dolos_runner/run_pairs.mjs  (기본: 패키지 상대경로)
JCQ_DOLOS_TIMEOUT_S=120

# CORS — admin dashboard origin (콤마 구분)
JCQ_DASHBOARD_ORIGIN=http://localhost:6010,http://localhost:5173
